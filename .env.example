# ==============================================================================
# WEFGIS Single Sign-On Portal Environment Configuration (TEMPLATE)
# Salin file ini menjadi .env dan sesuaikan nilai URL untuk server Anda.
# ==============================================================================

# Portal Branding & Display
VITE_APP_NAME="WEFGIS Single Sign-On Portal"
VITE_PORTAL_TITLE="WEFGIS"
VITE_PORTAL_BADGE="Single Sign-On"

# Keycloak OIDC Authentication Configuration
# Contoh production: https://sso.wefgis.org/realms/wefgis
VITE_KEYCLOAK_REALM="wefgis"
VITE_KEYCLOAK_AUTHORITY="http://localhost:8081/realms/wefgis"
VITE_KEYCLOAK_CLIENT_ID="portal"
VITE_KEYCLOAK_ACCOUNT_URL="http://localhost:8081/realms/wefgis/account"
VITE_SESSION_CHECK_INTERVAL_SECONDS="2"

# Landing / Logout Redirect URL
VITE_LANDING_URL="http://localhost:3000"

# Target Ekosistem Aplikasi WEFGIS
# 1. VoxaGIS (Spatial Infrastructure & Analysis)
VITE_APP_VOXAGIS_URL="http://localhost:5175"
VITE_APP_VOXAGIS_ENTRY_PATH="/sso/start?returnTo=%2Fdashboard"

# 2. Grovia (Biomass & Mangrove Carbon Analytics)
VITE_APP_GROVIA_URL="http://localhost:5173"
VITE_APP_GROVIA_ENTRY_PATH="/sso/start?returnTo=%2Fdashboard"

# 3. FlowGIS (Hydrology & Flood Risk Monitoring)
VITE_APP_FLOWGIS_URL="http://localhost:5174"
VITE_APP_FLOWGIS_ENTRY_PATH="/sso/start?returnTo=%2Fmap"

# Default Preferences
VITE_DEFAULT_LANGUAGE="en"
VITE_DEFAULT_THEME="dark"
